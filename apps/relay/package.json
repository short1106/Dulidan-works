{
  "name": "@dulidan/relay",
  "productName": "Dulidan Relay",
  "version": "0.1.0",
  "private": true,
  "description": "Dulidan Relay: Mail und Kalender von Dulidan Works",
  "author": "Dulidan Studios",
  "homepage": "https://dulidan.de",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "electron ../../packages/design-system/scripts/export-icons.cjs ../../packages/design-system/src/logo/icons/relay.svg build",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@dulidan/core": "*",
    "@dulidan/design-system": "*",
    "@dulidan/editor": "*",
    "@dulidan/mail-core": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
