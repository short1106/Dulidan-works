{
  "name": "dulidan-works",
  "private": true,
  "description": "Dulidan Works: die Programmfamilie von Dulidan Studios",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dulidan/glyph",
    "build": "npm run build --workspace @dulidan/glyph",
    "dist:win": "npm run dist:win --workspace @dulidan/glyph",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
